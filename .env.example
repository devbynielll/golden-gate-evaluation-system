APP_NAME="Golden Gate Evaluation System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=golden_gate_evaluation_session
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=golden_gate_evaluation_cache
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Golden Gate Evaluation System"
LOG_CHANNEL=stderr
LOG_LEVEL=warning
RAILPACK_SKIP_MIGRATIONS=true
RAILPACK_PHP_ROOT_DIR=/app/public
RAILPACK_PHP_EXTENSIONS=pdo_mysql,mbstring,gd,zip,intl,pcntl
